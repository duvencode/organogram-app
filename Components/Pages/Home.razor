    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("orgDrag.init", _dotNetRef);
        }
        if (_scrollToMoved && _movedId is int id)
        {
            _scrollToMoved = false;
            await JS.InvokeVoidAsync("eval", $"document.getElementById('emp-{id}')?.scrollIntoView({{behavior:'smooth',block:'center',inline:'center'}})");
        }
    }

    private string _search = "";

    private string? _selDept;

    private void ToggleDept(string d)
    {
        _selDept = _selDept == d ? null : d;
        if (_selDept != null && _employees!.FirstOrDefault(Matches) is { } first)
            GoTo(first.Id);
    }

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search) || _selDept != null;

    private bool Matches(Employee e)
    {
        if (_selDept != null && e.Department != _selDept) return false;
        var q = _search.Trim();
        if (q.Length == 0) return true;
        return Contains(e.Name, q) || Contains(e.Position, q) || Contains(e.Department, q)
            || Contains(e.JobGrade, q) || Contains(e.Status, q);
    }

    private static bool Contains(string? s, string q) =>
        s?.Contains(q, StringComparison.OrdinalIgnoreCase) == true;

    private int MatchCount => _employees!.Count(Matches);

    private void ClearSearch() { _search = ""; _selDept = null; }

    private void OnSearchKey(KeyboardEventArgs k)
    {
        if (k.Key == "Enter" && HasSearch && _employees!.FirstOrDefault(Matches) is { } first)
            GoTo(first.Id);
    }

    private void ClearMoved() { _movedId = null; _search = ""; _selDept = null; }

    private void GoTo(int id)
    {
        _movedId = id;
        _scrollToMoved = true;
    }

    private void StartDelete(Employee e) => _deleting = e;

    private void CancelDelete() => _deleting = null;

    private bool _confirmClear;

    private async Task ClearAll()
    {
        _confirmClear = false;
        await EmployeeService.ClearAllAsync();
        _employees = await EmployeeService.GetEmployeesAsync();
        _movedId = null;
        _search = "";
        _selDept = null;
        Rebuild();
    }

    private async Task ConfirmDelete()
    {
        if (_deleting is null) return;
        await EmployeeService.DeleteAsync(_deleting.Id);
        _deleting = null;
        Rebuild();
    }

    private void Rebuild()
    {
        _departments = _employees
            .GroupBy(e => e.Department)
            .OrderBy(g => g.Key)
            .Select(g => g.Key)
            .Concat(EmployeeService.ExtraDepartments.Where(d => _employees!.All(x => x.Department != d)).OrderBy(d => d))
            .ToList();

        _grades = _employees
            .Select(e => e.JobGrade)
            .Concat(EmployeeService.ExtraGrades)
            .Distinct()
            .OrderBy(c => { var i = EmployeeService.GradeOrder.ToList().IndexOf(c); return i < 0 ? int.MaxValue : i; })
            .ThenByDescending(c => c, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _gradeOptions = [.. _grades];
    }

	private const int CardW = 230, CardH = 130, SlotW = 250, RowH = 180, LabelW = 280, HeadH = 60;

	private sealed class TreeLayout
	{
		public Dictionary<int, (int X, int Y)> Pos { get; } = [];
		public List<string> Lines { get; } = [];
		public List<(string Name, int X, int Width, int Count)> Heads { get; } = [];
		public int Width, Height;
	}

	private TreeLayout BuildLayout()
	{
		var L = new TreeLayout();
		var emps = _employees!;
		var byId = emps.ToDictionary(e => e.Id);
		var rowOf = _grades.Select((g, i) => (g, i)).ToDictionary(t => t.g, t => t.i);
		// Children only nest under a manager in the same department so each department stays one block.
		bool SameDeptManager(Employee e) => e.ReportsToId is int m && m != e.Id && byId.TryGetValue(m, out var mgr) && mgr.Department == e.Department;
		var kids = emps.Where(SameDeptManager)
			.GroupBy(e => e.ReportsToId!.Value)
			.ToDictionary(g => g.Key, g => g.OrderBy(x => x.Name).ToList());

		var xs = new Dictionary<int, double>();
		var visited = new HashSet<int>();
		double next = 0;

		void Place(Employee e)
		{
			visited.Add(e.Id);
			var ch = kids.TryGetValue(e.Id, out var list) ? list.Where(c => !visited.Contains(c.Id)).ToList() : [];
			foreach (var c in ch) visited.Add(c.Id);
			foreach (var c in ch) Place(c);
			if (ch.Count == 0) xs[e.Id] = next++;
			else xs[e.Id] = (xs[ch[0].Id] + xs[ch[^1].Id]) / 2;
		}

		var deptOrder = _departments.Concat(emps.Select(e => e.Department)).Distinct().ToList();
		foreach (var d in deptOrder)
		{
			var inDept = emps.Where(e => e.Department == d).OrderBy(e => e.Name).ToList();
			if (inDept.Count == 0) continue;
			foreach (var r in inDept.Where(e => !SameDeptManager(e))) if (!visited.Contains(r.Id)) Place(r);
			foreach (var e in inDept) if (!visited.Contains(e.Id)) Place(e);
			next += 0.5;
		}

		foreach (var grp in emps.GroupBy(e => rowOf.GetValueOrDefault(e.JobGrade)))
		{
			double last = double.NegativeInfinity;
			foreach (var e in grp.OrderBy(e => xs[e.Id]))
			{
				if (xs[e.Id] < last + 1) xs[e.Id] = last + 1;
				last = xs[e.Id];
			}
		}

		int maxX = 0;
		foreach (var e in emps)
		{
			var x = e.CardX is int ox ? Math.Max(0, ox) : LabelW + (int)Math.Round(xs[e.Id] * SlotW);
			var y = HeadH + rowOf.GetValueOrDefault(e.JobGrade) * RowH + (RowH - CardH) / 2;
			L.Pos[e.Id] = (x, y);
			maxX = Math.Max(maxX, x + CardW);
		}

		foreach (var e in emps)
		{
			if (!(e.ReportsToId is int m) || !L.Pos.TryGetValue(m, out var pp) || m == e.Id) continue;
			var cp = L.Pos[e.Id];
			int px = pp.X + CardW / 2, py = pp.Y + CardH, cx = cp.X + CardW / 2, cy = cp.Y;
			var mid = cy - (RowH - CardH) / 4;
			L.Lines.Add($"M{px},{py} V{mid} H{cx} V{cy}");
		}

		foreach (var d in deptOrder)
		{
			var members = emps.Where(e => e.Department == d).ToList();
			if (members.Count == 0) continue;
			var minX = members.Min(e => L.Pos[e.Id].X);
			var maxDX = members.Max(e => L.Pos[e.Id].X) + CardW;
			L.Heads.Add((d, minX, maxDX - minX, members.Count));
		}

		L.Width = maxX + 20;
		L.Height = HeadH + Math.Max(1, _grades.Count) * RowH;
		return L;
	}

    private string ManagerLabel(Employee e)
    {
        var m = _employees!.FirstOrDefault(x => x.Id == e.ReportsToId);
        return m?.Name ?? e.ReportsToPosition ?? $"#{e.ReportsToId}";
    }
