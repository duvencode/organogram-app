    private async Task ShowHistory(int? employeeId)
    {
        _historyMenuOpen = false;
        _historyEmployeeId = employeeId;
        _historySearch = "";
        _history = await EmployeeService.GetHistoryAsync();
    }

    private void CloseHistory() => _history = null;

    private IEnumerable<HistoryEntry> FilteredHistory()
    {
        var q = _history!.AsEnumerable();
        if (_historyEmployeeId is int id) q = q.Where(h => h.EmployeeId == id);
        var s = _historySearch.Trim();
        if (s.Length > 0)
            q = q.Where(h => Contains(h.EmployeeName, s) || Contains(h.Position, s) || Contains(h.Event, s)
                || Contains(h.Field, s) || Contains(h.OldValue, s) || Contains(h.NewValue, s));
        return q;
    }

    private void StartEditGrades() { _gradeMenuOpen = false; _gradeEdits = _grades.ToDictionary(g => g, g => g); }

    private async Task SaveDepartments()
    {
        if (_deptEdits is null) return;
        foreach (var (oldName, newName) in _deptEdits)
        {
            var name = newName.Trim();
            if (name.Length > 0 && name != oldName)
                await EmployeeService.RenameDepartmentAsync(oldName, name);
        }
        _deptEdits = null;
        Rebuild();
    }

    private async Task SaveGrades()
    {
        if (_gradeEdits is null) return;
        var finalNames = _gradeEdits
            .Select(kv => kv.Value.Trim().Length > 0 ? kv.Value.Trim() : kv.Key)
            .ToList();
        var duplicates = finalNames.GroupBy(n => n, StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var map = new Dictionary<string, string>();
        foreach (var (oldValue, newValue) in _gradeEdits)
        {
            var value = newValue.Trim();
            if (value.Length > 0 && value != oldValue && !duplicates.Contains(value))
                map[oldValue] = value;
        }
        await EmployeeService.RenameGradesAsync(map);
        _gradeEdits = null;
        Rebuild();
    }

    private async Task SaveEdit()
    {
        if (_editing is null) return;
        _editing.Department = _editing.Department?.Trim() ?? "";
        if (_isNew)
        {
            await EmployeeService.AddAsync(_editing);
        }
        else
        {
            await EmployeeService.UpdateAsync(_editing);
        }
        _movedId = _editing.Id;
        _editing = null;
        Rebuild();
        _scrollToMoved = true;
    }

    private int? _movedId;
    private bool _scrollToMoved;

    private DotNetObjectReference<Home>? _dotNetRef;
    [JSInvokable]
    public async Task OnCardMoved(int id, int x)
    {
        await EmployeeService.SetCardXAsync(id, x);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnCardsMoved(int[] ids, int[] xs)
